# Copy this file to .env at Dreachy's instance path and adjust as needed.
# Never commit a real .env.
#
# On a real install, that path is ~/.local/share/dreachy/.env on the robot
# (created automatically on first run — see README.md "Configuration").
# During local development, put it wherever you point --instance-path, or
# just export these as real environment variables before running the app.

# --- Required: your Drupal site ---
# Normally set from the app's own settings page on the dashboard (no SSH
# needed) — this file only matters if you're configuring by hand, e.g.
# scripting a fresh install. Must expose JSON:API with anonymous read access
# to the content Dreachy should talk about. See README.md "Requirements".
DREACHY_BASE_URL=https://your-drupal-site.example

# --- Optional: language prefix ---
# Multilingual sites serve JSON:API under a language code (/en/jsonapi/...).
# Set it to that code, or to an empty value for a single-language site, which
# has no prefix at all. Defaults to 'en' when this key is absent entirely.
DREACHY_LOCALE=en

# --- Optional: content types ---
# Comma-separated machine names of the content types Dreachy talks about,
# normally set from the settings page's checkboxes. Empty or absent means
# every type the site has, including ones added later.
# DREACHY_TYPES=article,recipe

# --- Optional: site login (private sites only) ---
# Normally set from the settings page's "Advanced: site login". Leave unset
# for a public site. The secret belongs in the instance .env only — never in
# this file, the profile, or the repo.
# DREACHY_AUTH=oauth
# DREACHY_OAUTH_CLIENT_ID=dreachy
# DREACHY_OAUTH_CLIENT_SECRET=
# Optional: a scope to request by name. Empty = none sent; the site applies
# the OAuth client's default scope (see docs/drupal-setup.md).
# DREACHY_OAUTH_SCOPE=

# Optional: the content type dictated notes are saved as (editing needs the
# site login). Empty = the first content type Dreachy talks about.
# DREACHY_NOTE_TYPE=

# --- Optional: MCP mode (R4; needs the site login above) ---
# Normally set from the settings page's Advanced section. See README.md
# "MCP mode" and docs/drupal-setup.md §9.
# DREACHY_BACKEND=mcp
# Empty = the site URL + /mcp. Must be on the site's own address.
# DREACHY_MCP_ENDPOINT=
# The Search API index content searches use.
# DREACHY_MCP_SEARCH_INDEX=content_vector
# Optional: the content types to use (empty = those that have content).
# DREACHY_MCP_BUNDLES=
# Optional: extra MCP tools Dreachy may run on request (never publishing,
# homepage, site-default, delete or discard tools).
# DREACHY_MCP_EXTRA_TOOLS=
# Optional, advanced: name the site's tools when their names don't follow the
# usual pattern, e.g. {"search": "mysite_search", "search_params": {"min_score": 0.4}}
# DREACHY_MCP_MAPPING=

# --- Required: conversation backend ---
# Hugging Face token used by reachy_mini_conversation_app for the realtime
# voice/LLM backend.
HF_TOKEN=

# --- Optional: passed straight through to reachy_mini_conversation_app ---
# See its own .env.example for the full list. A few likely to be useful here:

# REALTIME_TRANSCRIPTION_LANGUAGE="en"
# HF_REALTIME_CONNECTION_MODE="deployed"
# HF_REALTIME_WS_URL="ws://127.0.0.1:8765/v1/realtime"
# REACHY_MINI_APP_TIMEOUT_MINUTES=1440
